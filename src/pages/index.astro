---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Inicio">
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(139,92,246,0.14)_0%,_transparent_70%)] pointer-events-none" />
    
    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto">
      <div class="mb-8">
        <img
          src="/manzft/manzft27.png"
          alt="Manzft"
          class="w-28 h-28 md:w-36 md:h-36 rounded-full mx-auto border-2 border-accent/40 object-cover shadow-[0_0_25px_rgba(139,92,246,0.35),0_0_80px_rgba(236,72,153,0.15)]"
        />
      </div>
      
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-4">
        <span class="text-ink">Manzft</span>
      </h1>
      
      <p class="text-xl md:text-2xl text-ink-soft mb-10">
        Desarrollador de software & creador de contenido
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/wonder-maker" class="btn-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Ver Wonder Maker
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-20">
    <div class="max-w-2xl mx-auto">
      <a href="/wonder-maker" class="card p-8 group cursor-pointer block text-center">
        <div class="flex items-center justify-center gap-4 mb-4">
          <img src="/wonder-maker/icon.png" alt="Wonder Maker" class="w-12 h-12 rounded-xl" />
          <div>
            <h3 class="text-xl font-bold text-ink group-hover:text-accent transition-colors">Wonder Maker</h3>
            <p class="text-sm text-ink-soft">Fangame de SMM2</p>
          </div>
        </div>
        <p class="text-ink-soft text-sm leading-relaxed">
          El editor de Mario definitivo. Construye y juega niveles con la estética y fluidez de Mario Wonder.
        </p>
        <span class="inline-block mt-4 text-accent text-sm font-medium group-hover:translate-x-1 transition-transform">
          Explorar proyecto →
        </span>
      </a>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16 text-center">
    <h2 class="section-title">Mis redes</h2>
    <p class="section-subtitle">Sígueme y únete a la comunidad</p>
    
    <div class="flex flex-wrap justify-center gap-4">
      <a href="https://youtube.com/@manzft" target="_blank" rel="noopener noreferrer"
         class="btn-download" style="background:#ff0000;">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        YouTube
      </a>
      <a href="https://twitch.tv/manzft27" target="_blank" rel="noopener noreferrer"
         class="btn-download" style="background:#9146ff;">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714Z"/></svg>
        Twitch
      </a>
      <a href="https://x.com/manzft27" target="_blank" rel="noopener noreferrer"
         class="btn-download" style="background:#1da1f2;">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        Twitter/X
      </a>
      <a href="https://discord.com/users/manzft27" target="_blank" rel="noopener noreferrer"
         class="btn-download" style="background:#5865f2;">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
        Discord
      </a>
    </div>
  </section>
</BaseLayout>
