---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Wonder Maker" description="El mejor fangame de SMM2 con estética Wonder. Editor de niveles para PC, Android y Linux.">
  <div class="wm-page">
    <section class="wm-hero">
      <div class="wm-hero-inner">
        <img src="/wonder-maker/logo.gif" alt="Wonder Maker" class="wm-logo" />

        <p class="wm-hero-lead" data-i18n="wonder.title">
          El Super Mario Maker 3 no oficial
        </p>
        <p class="wm-hero-sub" data-i18n="wonder.sub">
          Disponible para PC y Android
        </p>

        <div class="wm-hero-pills">
          <div id="download-count" class="wm-pill wm-count">
            <span class="wm-count-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4v12m0 0-4-4m4 4 4-4M4 19h16" />
              </svg>
            </span>
            <span class="wm-count-copy">
              <span id="download-count-number" class="wm-count-number">0</span>
              <span class="wm-count-label" data-i18n="wonder.downloads">Descargas</span>
            </span>
          </div>
        </div>

        <div class="wm-actions">
          <div class="wm-btn-wrap wm-btn-wrap--icon">
            <a href="#download" class="wm-btn wm-btn--lg">
              <span class="wm-btn__frame"><span class="wm-btn__face">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4v12m0 0-4-4m4 4 4-4M4 19h16" />
                </svg>
                <span data-i18n="wonder.downloadBeta">Descargar Old Beta</span>
              </span></span>
            </a>
            <img src="/wonder-maker/icon.png" alt="" class="wm-cta-icon" />
          </div>

          <div class="wm-btn-wrap">
            <a href="#discord" class="wm-btn wm-btn--lg">
              <span class="wm-btn__frame"><span class="wm-btn__face">
                <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
              </svg>
                Wonder Cave
              </span></span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="wm-section">
      <header class="wm-section-head">
        <span class="wm-section-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2.5" y="7" width="19" height="11" rx="3.5" />
            <path d="M8 11v3M6.5 12.5h3M15.5 11.5h.01M18 13.5h.01" />
          </svg>
        </span>
        <h2 class="wm-section-title" data-i18n="wonder.styles">Estilos de juego</h2>
        <p class="wm-section-sub" data-i18n="wonder.stylesSub">Esto es solo una beta, habrán más estilos en la versión final.</p>
      </header>

      <div class="wm-grid wm-grid--4">
        <article class="wm-card wm-card--style">
          <div class="wm-style-art"><img src="/wonder-maker/smb.png" alt="SMB" /></div>
          <h3>Super Mario Bros</h3>
          <p data-i18n="wonder.style1">El estilo clásico de Mario pero modernizado.</p>
        </article>

        <article class="wm-card wm-card--style">
          <div class="wm-style-art"><img src="/wonder-maker/smb3.png" alt="SMB3" /></div>
          <h3>Super Mario Bros 3</h3>
          <p data-i18n="wonder.style2">Vuela con el Tanooki con nuevas físicas.</p>
        </article>

        <article class="wm-card wm-card--style">
          <div class="wm-style-art"><img src="/wonder-maker/smw.png" alt="SMW" /></div>
          <h3>Super Mario World</h3>
          <p data-i18n="wonder.style3">El mejor Mario 2D de los 90.</p>
        </article>

        <article class="wm-card wm-card--style">
          <div class="wm-style-art"><img src="/wonder-maker/nsmbu.png" alt="NSMBU" /></div>
          <h3>New Super Mario Bros U</h3>
          <p data-i18n="wonder.style4">Juega en este moderno estilo de forma nativa.</p>
        </article>
      </div>
    </section>

    <section id="download" class="wm-section">
      <header class="wm-section-head">
        <span class="wm-section-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v11m0 0-4-4m4 4 4-4M4 19h16" />
          </svg>
        </span>
        <h2 class="wm-section-title" data-i18n="wonder.downloadTitle">Descarga la Old Beta</h2>
        <p class="wm-section-sub" data-i18n="wonder.downloadSub">Elige tu plataforma y empieza a crear niveles.</p>
      </header>

      <div class="wm-grid wm-grid--3">
        <article class="wm-card wm-card--download">
          <span class="wm-platform-icon">
            <svg viewBox="0 0 448 512" fill="currentColor">
              <path d="M0 93.7l183.6-25.3v177.4H0V93.7zm0 324.6l183.6 25.3V268.4H0v149.9zm203.8 28L448 480V268.4H203.8v177.9zm0-380.6v180.1H448V32L203.8 65.7z" />
            </svg>
          </span>
          <h3>Windows</h3>
          <p>EXE</p>
          <div class="wm-btn-wrap">
            <a href="https://github.com/Manzft/wonder-maker-fangame/releases/download/Beta-v1.1.1/wm-beta-v1.1.1-windows.zip" target="_blank" rel="noopener noreferrer" class="wm-btn wm-btn--sm wm-download">
              <span class="wm-btn__frame"><span class="wm-btn__face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4v12m0 0-4-4m4 4 4-4M4 19h16" />
              </svg>
              <span data-i18n="wonder.download">Descargar</span>
            </span></span>
            </a>
          </div>
        </article>

        <article class="wm-card wm-card--download">
          <span class="wm-platform-icon">
            <svg viewBox="0 0 576 512" fill="currentColor">
              <path d="M420.55,301.93a24,24,0,1,1,24-24,24,24,0,0,1-24,24m-265.1,0a24,24,0,1,1,24-24,24,24,0,0,1-24,24m273.7-144.48,47.94-83a10,10,0,1,0-17.27-10h0l-48.54,84.07a301.25,301.25,0,0,0-246.56,0L116.18,64.45a10,10,0,1,0-17.27,10h0l47.94,83C64.53,202.22,8.24,285.55,0,384H576c-8.24-98.45-64.54-181.78-146.85-226.55" />
            </svg>
          </span>
          <h3>Android</h3>
          <p>APK</p>
          <div class="wm-btn-wrap">
            <a href="https://github.com/Manzft/wonder-maker-fangame/releases/download/Beta-v1.1.1/wm-beta-v1.1.1-android.apk" target="_blank" rel="noopener noreferrer" class="wm-btn wm-btn--sm wm-download">
              <span class="wm-btn__frame"><span class="wm-btn__face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4v12m0 0-4-4m4 4 4-4M4 19h16" />
              </svg>
              <span data-i18n="wonder.download">Descargar</span>
            </span></span>
            </a>
          </div>
        </article>

        <article class="wm-card wm-card--download">
          <span class="wm-platform-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4.5" width="18" height="15" rx="2.5" />
              <path d="M7 9.5l3 2.5-3 2.5M12.5 14.5h4.5" />
            </svg>
          </span>
          <h3>Linux</h3>
          <p>X86_64</p>
          <div class="wm-btn-wrap">
            <a href="https://github.com/Manzft/wonder-maker-fangame/releases/download/Beta-v1.1.1/wm-beta-v1.1.1-linux.zip" target="_blank" rel="noopener noreferrer" class="wm-btn wm-btn--sm wm-download">
              <span class="wm-btn__frame"><span class="wm-btn__face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4v12m0 0-4-4m4 4 4-4M4 19h16" />
              </svg>
              <span data-i18n="wonder.download">Descargar</span>
            </span></span>
            </a>
          </div>
        </article>
      </div>
    </section>

    <section id="discord" class="wm-section">
      <div class="wm-card wm-card--discord">
        <img src="/wonder-maker/wclogo_nobg.png" alt="" />
        <h3>Wonder Cave</h3>
        <p data-i18n="wonder.discordDesc">
          Únete al servidor oficial de Discord para estar al tanto de las novedades,
          reportar bugs y compartir tus niveles.
        </p>
        <div class="wm-btn-wrap">
          <a href="https://discord.com/invite/csGS3eKxvD" target="_blank" rel="noopener noreferrer" class="wm-btn wm-btn--lg">
              <span class="wm-btn__frame"><span class="wm-btn__face">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" />
            </svg>
            <span data-i18n="wonder.join">Unirse a Wonder Cave</span>
          </span></span>
            </a>
        </div>
      </div>
    </section>
  </div>

  <div id="wm-ad-modal" class="wm-ad-overlay" hidden>
    <div class="wm-ad-window" role="dialog" aria-modal="true" aria-labelledby="wm-ad-title" tabindex="-1">
      <div class="wm-ad-titlebar">
        <span class="wm-ad-title-left">
          <svg class="wm-ad-heart" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 21s-7.5-4.6-9.5-8.4C1 9.7 2.4 6.5 5.5 5.8 7.4 5.4 9.2 6.3 12 9c2.8-2.7 4.6-3.6 6.5-3.2 3.1.7 4.5 3.9 3 6.8C19.5 16.4 12 21 12 21z" />
          </svg>
          <h3 id="wm-ad-title" data-i18n="support.title">Apoyo</h3>
        </span>
        <button id="wm-ad-close" class="wm-ad-close" type="button" data-i18n-aria="support.close" aria-label="Cerrar">✕</button>
      </div>

      <div class="wm-ad-body">
        <p class="wm-ad-copy">
          <span data-i18n="support.before">Un anuncio se abrirá en</span>
          <span id="wm-ad-count" class="wm-ad-count">5</span>
          <span data-i18n="support.after">segundos para apoyar de forma gratuita al proyecto, puedes cerrarlo en cuanto se abra, después de eso podrás descargar sin ningún problema.</span>
        </p>

        <div class="wm-btn-wrap wm-ad-download-wrap">
          <a id="wm-ad-download" class="wm-btn wm-btn--lg is-locked" href="#" target="_blank" rel="noopener noreferrer" aria-disabled="true" tabindex="-1">
            <span class="wm-btn__frame"><span class="wm-btn__face">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4v12m0 0-4-4m4 4 4-4M4 19h16" />
              </svg>
              <span data-i18n="support.download">Descargar</span>
            </span></span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <style is:global>
    .wm-page {
      --wm-cream: #f4f1e4;
      --wm-cream-soft: #e9e5d4;
      --wm-ink: #20261b;
      --wm-muted: #d3d7c2;
      --wm-green: #3c4a33;
      --wm-green-dark: #2e3a27;
      --wm-yellow: #fdff12;
      --wm-red: #e94b3c;
      position: relative;
      overflow: hidden;
      isolation: isolate;
      padding: 0 0 72px;
      color: #f7f4e8;
      font-family: var(--font-sans);
      font-weight: 600;
      background-color: #6c7f61;
    }

    .wm-page::before {
      content: "";
      position: fixed;
      top: 50%;
      left: 50%;
      width: 200vmax;
      height: 200vmax;
      margin-top: -100vmax;
      margin-left: -100vmax;
      z-index: 0;
      pointer-events: none;
      background-color: #6c7f61;
      background-image: url('/wonder-maker/background.webp');
      background-size: 1920px 1920px;
      background-repeat: repeat;
      background-blend-mode: luminosity;
      transform: rotate(-15deg);
      transform-origin: center;
      animation: wm-bg-pan 90s ease-in-out infinite alternate;
    }

    .wm-page::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        radial-gradient(ellipse 75% 45% at 50% 0%, rgba(255, 255, 255, .07), transparent 60%),
        radial-gradient(ellipse 90% 60% at 50% 105%, rgba(0, 0, 0, .28), transparent 65%),
        linear-gradient(rgba(255, 255, 255, .10), rgba(255, 255, 255, .10));
    }

    .wm-page > * {
      position: relative;
      z-index: 1;
    }

    @keyframes wm-bg-pan {
      from {
        transform: translate(0, 0) rotate(-15deg);
      }
      to {
        transform: translate(480px, 120px) rotate(-15deg);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .wm-page::before {
        animation: none;
      }
    }

    .wm-page h1,
    .wm-page h2,
    .wm-page h3,
    .wm-page h4 {
      font-family: var(--font-display);
      letter-spacing: 0;
    }

    .wm-page ::selection {
      background: rgba(253, 255, 18, .35);
      color: #fff;
    }

    /* ---------- Hero ---------- */
    .wm-hero {
      position: relative;
      padding: 78px 24px 62px;
      text-align: center;
    }

    .wm-hero-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .wm-logo {
      display: block;
      height: clamp(110px, 15vw, 170px);
      width: auto;
      margin: 0 auto 22px;
      filter: drop-shadow(0 8px 0 rgba(0, 0, 0, .18));
    }

    .wm-hero-lead {
      margin: 0 auto 8px;
      max-width: 760px;
      font-size: clamp(1.3rem, 2.5vw, 1.8rem);
      font-weight: 700;
      line-height: 1.15;
      color: #fff;
      text-shadow: 0 3px 0 rgba(0, 0, 0, .22);
    }

    .wm-hero-lead strong,
    .wm-accent {
      color: var(--wm-yellow);
      font-weight: 800;
    }

    .wm-hero-sub {
      margin: 0 auto 26px;
      max-width: 660px;
      font-size: clamp(1rem, 1.8vw, 1.18rem);
      font-weight: 600;
      color: var(--wm-muted);
      line-height: 1.35;
    }

    .wm-hero-pills {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 12px;
      margin-bottom: 30px;
    }

    .wm-pill {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 9px 17px;
      border-radius: 999px;
      background: var(--wm-cream);
      color: var(--wm-ink);
      font-size: .95rem;
      font-weight: 700;
      box-shadow:
        0 4px 0 rgba(0, 0, 0, .16),
        0 10px 22px rgba(0, 0, 0, .14),
        inset 0 1px 0 rgba(255, 255, 255, .7);
    }

    .wm-count {
      padding: 6px 16px 6px 7px;
      gap: 10px;
      animation: wm-count-pop .5s cubic-bezier(.16, 1, .3, 1) .1s backwards;
    }

    @keyframes wm-count-pop {
      from { opacity: 0; transform: translateY(8px) scale(.96); }
      to { opacity: 1; transform: none; }
    }

    .wm-count-icon {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--wm-yellow);
      color: var(--wm-ink);
      box-shadow: inset 0 -2px 0 rgba(0, 0, 0, .12);
    }

    .wm-count-icon svg {
      width: 18px;
      height: 18px;
    }

    .wm-count-copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      line-height: 1;
    }

    .wm-count-number {
      font-size: 1.25rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
      color: var(--wm-ink);
    }

    .wm-count-label {
      margin-top: 3px;
      font-size: .62rem;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: #747b64;
    }

    .wm-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 20px;
    }

    .wm-btn-wrap--icon {
      position: relative;
    }

    .wm-cta-icon {
      position: absolute;
      right: -12px;
      bottom: -12px;
      width: 58px;
      height: 58px;
      object-fit: contain;
      filter: drop-shadow(0 3px 0 rgba(0, 0, 0, .22));
      pointer-events: none;
    }

    /* ---------- Sections ---------- */
    .wm-section {
      max-width: 1120px;
      margin: 0 auto;
      padding: 30px 24px 54px;
    }

    .wm-section-head {
      text-align: center;
      margin-bottom: 30px;
    }

    .wm-section-badge {
      display: grid;
      place-items: center;
      width: 54px;
      height: 54px;
      margin: 0 auto 14px;
      border-radius: 50%;
      background: var(--wm-cream);
      color: var(--wm-green-dark);
      box-shadow:
        0 4px 0 rgba(0, 0, 0, .16),
        0 10px 20px rgba(0, 0, 0, .12),
        inset 0 1px 0 rgba(255, 255, 255, .7);
    }

    .wm-section-badge svg {
      width: 27px;
      height: 27px;
    }

    .wm-section-title {
      margin: 0 0 8px;
      font-size: clamp(2rem, 3.4vw, 2.8rem);
      font-weight: 800;
      line-height: 1;
      color: #fff;
      text-shadow: 0 3px 0 rgba(0, 0, 0, .2);
    }

    .wm-section-sub {
      max-width: 560px;
      margin: 0 auto;
      font-size: 1.05rem;
      font-weight: 600;
      line-height: 1.35;
      color: var(--wm-muted);
    }

    /* ---------- Cards ---------- */
    .wm-grid {
      display: grid;
      gap: 22px;
    }

    .wm-grid--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .wm-grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 960px;
      margin: 0 auto;
    }

    .wm-card {
      position: relative;
      padding: 22px;
      border-radius: 22px;
      text-align: center;
      color: var(--wm-ink);
      background: var(--wm-cream);
      box-shadow:
        0 5px 0 rgba(0, 0, 0, .18),
        0 14px 28px rgba(0, 0, 0, .16),
        inset 0 1px 0 rgba(255, 255, 255, .8),
        inset 0 -3px 0 rgba(0, 0, 0, .05);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .wm-card:hover {
      transform: translateY(-3px);
      box-shadow:
        0 8px 0 rgba(0, 0, 0, .18),
        0 18px 34px rgba(0, 0, 0, .2),
        inset 0 1px 0 rgba(255, 255, 255, .8),
        inset 0 -3px 0 rgba(0, 0, 0, .05);
    }

    .wm-card h3 {
      margin: 0 0 6px;
      font-size: 1.3rem;
      font-weight: 800;
      line-height: 1.05;
      color: #1f2819;
    }

    .wm-card p {
      margin: 0;
      font-size: .98rem;
      font-weight: 600;
      line-height: 1.35;
      color: #5f6754;
    }

    .wm-style-art {
      display: grid;
      place-items: center;
      height: 116px;
      margin-bottom: 14px;
      border-radius: 16px;
      background: var(--wm-cream-soft);
      box-shadow: inset 0 -3px 0 rgba(0, 0, 0, .05);
    }

    .wm-style-art img {
      width: auto;
      height: 70px;
      object-fit: contain;
      image-rendering: pixelated;
      filter: drop-shadow(0 4px 0 rgba(0, 0, 0, .12));
    }

    .wm-platform-icon {
      display: grid;
      place-items: center;
      width: 62px;
      height: 62px;
      margin: 0 auto 14px;
      border-radius: 50%;
      background: var(--wm-green-dark);
      color: var(--wm-cream);
      box-shadow: inset 0 -3px 0 rgba(0, 0, 0, .22);
    }

    .wm-platform-icon svg {
      width: 28px;
      height: 28px;
    }

    .wm-card--download p {
      margin: 0 0 16px;
      font-size: .78rem;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: #7a816b;
    }

    .wm-card--download {
      padding-bottom: 24px;
    }

    .wm-card--discord {
      max-width: 640px;
      margin: 0 auto;
      padding: 38px 30px;
    }

    .wm-card--discord img {
      width: 88px;
      height: 88px;
      margin: 0 auto 14px;
      object-fit: contain;
    }

    .wm-card--discord h3 {
      font-size: 1.8rem;
    }

    .wm-card--discord p {
      max-width: 450px;
      margin: 0 auto 22px;
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 980px) {
      .wm-grid--4 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 820px) {
      .wm-grid--3 {
        grid-template-columns: 1fr;
        max-width: 420px;
      }
    }

    @media (max-width: 560px) {
      .wm-hero {
        padding-top: 56px;
      }

      .wm-grid--4 {
        grid-template-columns: 1fr;
        max-width: 420px;
        margin: 0 auto;
      }

      .wm-section {
        padding-left: 18px;
        padding-right: 18px;
      }

      .wm-card--discord {
        padding: 30px 20px;
      }
    }

    /* el pie compartido se junta con la página verde */
    body:has(.wm-page) footer {
      margin-top: 0;
    }

    /* ---------- Ventana de apoyo ---------- */
    .wm-ad-overlay {
      --wm-ink: #20261b;
      --wm-cream: #f4f1e4;
      --wm-green-dark: #2e3a27;
      --wm-yellow: #fdff12;
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: grid;
      place-items: center;
      padding: 24px;
      background: rgba(10, 14, 8, .72);
      backdrop-filter: blur(6px);
    }

    .wm-ad-overlay[hidden] {
      display: none;
    }

    .wm-ad-window {
      width: min(480px, 100%);
      max-height: calc(100vh - 48px);
      overflow: auto;
      border: 3px solid var(--wm-ink);
      border-radius: 20px;
      background: var(--wm-cream);
      box-shadow:
        0 8px 0 rgba(0, 0, 0, .28),
        0 26px 60px rgba(0, 0, 0, .48);
      outline: none;
    }

    .wm-ad-titlebar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 16px 13px 18px;
      background: var(--wm-green-dark);
      color: var(--wm-cream);
      border-bottom: 3px solid var(--wm-ink);
    }

    .wm-ad-title-left {
      display: flex;
      align-items: center;
      gap: 10px;
      min-width: 0;
    }

    .wm-ad-heart {
      width: 27px;
      height: 27px;
      flex: none;
      color: #e94b3c;
      filter: drop-shadow(0 2px 0 rgba(0, 0, 0, .3));
    }

    .wm-ad-titlebar h3 {
      margin: 0;
      font-family: var(--font-display);
      font-size: 1.45rem;
      font-weight: 800;
      line-height: 1;
      color: var(--wm-cream);
    }

    .wm-ad-close {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      flex: none;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, .25);
      background: transparent;
      color: var(--wm-cream);
      font: 700 15px/1 var(--font-sans);
      cursor: pointer;
      transition: background .15s ease;
    }

    .wm-ad-close:hover {
      background: rgba(255, 255, 255, .14);
    }

    .wm-ad-body {
      padding: 22px 22px 24px;
      text-align: center;
    }

    .wm-ad-copy {
      margin: 0 0 20px;
      color: #4b5443;
      font-size: 1rem;
      line-height: 1.55;
      font-weight: 600;
    }

    .wm-ad-count {
      display: inline-grid;
      place-items: center;
      position: relative;
      top: -0.14em;
      min-width: 2rem;
      height: 2rem;
      margin: 0 .2rem;
      padding: 0 .35rem;
      border-radius: 999px;
      background: var(--wm-yellow);
      color: var(--wm-ink);
      font-size: 1.05rem;
      font-weight: 800;
      line-height: 1;
      box-shadow: inset 0 -2px 0 rgba(0, 0, 0, .12);
      vertical-align: middle;
    }

    .wm-ad-download-wrap {
      margin: 0 auto;
    }

    .wm-btn.is-locked {
      opacity: .42;
      filter: saturate(.35);
      pointer-events: none;
    }

    @media (max-width: 560px) {
      .wm-ad-overlay {
        padding: 16px;
      }

      .wm-ad-titlebar h3 {
        font-size: 1.25rem;
      }

      .wm-ad-body {
        padding: 18px 16px 20px;
      }

      .wm-ad-copy {
        font-size: .95rem;
      }
    }
  </style>

  <script>
    const numEl = document.getElementById('download-count-number');
    const CACHE_KEY = 'wm-dl-count';
    const CACHE_TS = 'wm-dl-count-ts';
    const DAY = 24 * 60 * 60 * 1000;

    function animateCount(from, to) {
      const duration = 1200;
      const start = performance.now();
      function frame(now) {
        const t = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        numEl.textContent = Math.round(from + (to - from) * eased).toLocaleString('es-ES');
        if (t < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    function cachedCount() {
      try {
        const ts = localStorage.getItem(CACHE_TS);
        if (ts && Date.now() - Number(ts) < DAY) {
          return Number(localStorage.getItem(CACHE_KEY));
        }
      } catch (e) {}
      return null;
    }

    function cacheCount(n) {
      try {
        localStorage.setItem(CACHE_KEY, String(n));
        localStorage.setItem(CACHE_TS, String(Date.now()));
      } catch (e) {}
    }

    const cached = cachedCount();
    if (cached !== null) animateCount(0, cached);

    fetch('https://api.github.com/repos/Manzft/wonder-maker-fangame/releases?per_page=100')
      .then((r) => r.json())
      .then((releases) => {
        const total = releases.reduce(
          (sum, rel) => sum + (rel.assets || []).reduce((s, a) => s + (a.download_count || 0), 0),
          0
        );
        animateCount(cached ?? 0, total);
        cacheCount(total);
      })
      .catch(() => {
        if (cached === null) numEl.textContent = '—';
      });

    (() => {
      const AD_URL = 'https://asiafilm.org/4/3cc45a8aed4cd9cc39510b5d448a6149';
      const AD_SECONDS = 5;
      const overlay = document.getElementById('wm-ad-modal');
      const windowEl = overlay ? overlay.querySelector('.wm-ad-window') : null;
      const closeBtn = document.getElementById('wm-ad-close');
      const countEl = document.getElementById('wm-ad-count');
      const downloadBtn = document.getElementById('wm-ad-download');

      if (!overlay || !windowEl || !countEl || !downloadBtn) return;

      let timer = null;
      let pendingUrl = '';
      let seconds = AD_SECONDS;

      function setLocked(locked) {
        if (locked) {
          downloadBtn.classList.add('is-locked');
          downloadBtn.setAttribute('aria-disabled', 'true');
          downloadBtn.setAttribute('tabindex', '-1');
          downloadBtn.setAttribute('href', '#');
        } else {
          downloadBtn.classList.remove('is-locked');
          downloadBtn.setAttribute('aria-disabled', 'false');
          downloadBtn.removeAttribute('tabindex');
          downloadBtn.setAttribute('href', pendingUrl);
        }
      }

      function finish() {
        clearInterval(timer);
        timer = null;

        window.open(AD_URL, '_blank', 'noopener,noreferrer');
        setLocked(false);
      }

      function start(url) {
        pendingUrl = url;
        seconds = AD_SECONDS;
        countEl.textContent = String(seconds);

        setLocked(true);
        overlay.hidden = false;
        document.body.style.overflow = 'hidden';
        windowEl.focus();

        clearInterval(timer);
        timer = setInterval(function () {
          seconds -= 1;
          countEl.textContent = String(Math.max(seconds, 0));
          if (seconds <= 0) finish();
        }, 1000);
      }

      function close() {
        clearInterval(timer);
        timer = null;
        overlay.hidden = true;
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.wm-download').forEach(function (link) {
        link.addEventListener('click', function (event) {
          event.preventDefault();
          start(link.href);
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', function () { close(); });

      overlay.addEventListener('click', function (event) {
        if (event.target === overlay) close();
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !overlay.hidden) close();
      });
    })();
  </script>
</BaseLayout>
