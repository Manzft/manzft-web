---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fanarts">
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(34,197,94,0.06)_0%,_transparent_50%)] pointer-events-none" />
    
    <div class="relative z-10 max-w-5xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">
          <span class="text-white">Fanarts de</span> <span class="text-accent">Manzft</span>
        </h1>
        <p class="text-gray-400 text-lg max-w-xl mx-auto">
          Arte creado por la comunidad. ¡Gracias por su apoyo!
        </p>
      </div>

      <div class="columns-1 md:columns-2 gap-6 space-y-6">
        <div class="card overflow-hidden break-inside-avoid">
          <img
            src="/fanarts/manzft_by_mari.webp"
            alt="Manzft by Mari"
            class="w-full"
          />
          <div class="p-4">
            <p class="text-gray-300 font-medium">by <span class="text-accent">Mari</span></p>
          </div>
        </div>
        <div class="card overflow-hidden break-inside-avoid">
          <img
            src="/fanarts/manzft_by_thexeart.png"
            alt="Manzft by Thexeart"
            class="w-full"
          />
          <div class="p-4">
            <p class="text-gray-300 font-medium">by <span class="text-accent">Thexeart</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
