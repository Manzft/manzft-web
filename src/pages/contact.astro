<BaseLayout title="Contacto">
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(139,92,246,0.12)_0%,_transparent_50%)] pointer-events-none" />
    
    <div class="relative z-10 max-w-4xl mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">
          <span class="text-ink" data-i18n="contact.title1">Conéctate</span> <span class="text-accent" data-i18n="contact.title2">conmigo</span>
        </h1>
        <p class="text-ink-soft text-lg max-w-xl mx-auto" data-i18n="contact.sub">
          Todas mis redes sociales en un solo lugar. ¡Sígueme y hablemos!
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-4 max-w-2xl mx-auto">
        {
          socials.map(({ name, handle, url, color, icon }) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="card p-5 flex items-center gap-4 group hover:scale-[1.02]"
              style={`--hover-color: ${color}`}
            >
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 transition-colors duration-300"
                style={`background: ${color}20; color: ${color}`}
              >
                <Fragment set:html={icon} />
              </div>
              <div class="min-w-0">
                <p class="font-bold text-ink group-hover:text-accent transition-colors text-lg">{name}</p>
                <p class="text-ink-soft text-sm truncate">{handle}</p>
              </div>
              <svg class="w-5 h-5 ml-auto text-ink-soft group-hover:text-accent transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <div class="inline-block card p-6">
          <p class="text-ink-soft text-sm mb-2" data-i18n="contact.direct">¿Quieres contactarme directamente?</p>
          <p class="text-ink font-medium">
            <span data-i18n="contact.email">Email:</span> <a href="mailto:manzft31@gmail.com" class="text-accent hover:underline">manzft31@gmail.com</a>
          </p>
          <p class="text-ink-soft text-xs mt-2" data-i18n="contact.open">Siempre estoy abierto a conversar</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
