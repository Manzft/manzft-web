          'contact.title1': 'Conéctate',
          'contact.title2': 'conmigo',
          'contact.sub': 'Todas mis redes sociales en un solo lugar. ¡Sígueme y hablemos!',
          'contact.direct': '¿Quieres contactarme directamente?',
          'contact.email': 'Email:',
          'contact.open': 'Siempre estoy abierto a conversar',
          'wonder.title': 'A native Super Mario Maker 3',
          'wonder.sub': 'Disponible para PC y Android',
          'wonder.downloads': 'Descargas',
          'wonder.downloadBeta': 'Descargar Beta',
          'wonder.styles': 'Estilos de juego',
          'wonder.stylesSub': 'Esto es solo una beta, habrán más estilos en la versión final.',
          'wonder.style1': 'El estilo clásico de Mario pero modernizado.',
          'wonder.style2': 'Vuela con el Tanooki con nuevas físicas.',
          'wonder.style3': 'El mejor Mario 2D de los 90.',
          'wonder.style4': 'Juega en este moderno estilo de forma nativa.',
          'wonder.downloadTitle': 'Descarga la Beta',
          'wonder.downloadSub': 'Elige tu plataforma y empieza a crear niveles.',
          'wonder.download': 'Descargar',
          'wonder.discordDesc': 'Únete al servidor oficial de Discord para estar al tanto de las novedades, reportar bugs y compartir tus niveles.',
          'wonder.join': 'Unirse a Wonder Cave',
          'support.title': 'Apoyo',
