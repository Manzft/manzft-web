          'support.after': 'segundos para apoyar de forma gratuita al proyecto, puedes cerrarlo en cuanto se abra, después de eso podrás descargar sin ningún problema.',
          'support.download': 'Descargar',
          'support.close': 'Cerrar'
        },
        en: {
          'lang.switch': 'Switch language',
          'nav.home': 'Home',
          'nav.wonder': 'Wonder Maker',
          'nav.fanarts': 'Fanarts',
          'nav.contact': 'Contact',
          'page.home': 'Home',
          'page.wonder': 'Wonder Maker',
          'page.fanarts': 'Fanarts',
          'page.contact': 'Contact',
          'meta.home': 'Manzft — Software developer and content creator',
          'meta.wonder': 'The best SMM2 fangame with Wonder aesthetics. Level editor for PC, Android and Linux.',
          'meta.fanarts': 'Art created by the community for Manzft.',
          'meta.contact': 'All my social networks in one place.',
          'home.role': 'Software developer & content creator',
          'home.view': 'View Wonder Maker',
          'home.fangame': 'SMM2 fangame',
          'home.desc': 'The definitive Mario editor. Build and play levels with the look and feel of Mario Wonder.',
          'home.explore': 'Explore project →',
          'home.socials': 'My socials',
          'home.follow': 'Follow me and join the community',
          'fanarts.title': 'Fanarts by',
          'fanarts.sub': 'Art created by the community. Thanks for your support!',
          'fanarts.by': 'by',
          'contact.title1': 'Connect',
          'contact.title2': 'with me',
          'contact.sub': "All my social networks in one place. Follow me and let's talk!",
          'contact.direct': 'Want to contact me directly?',
          'contact.email': 'Email:',
          'contact.open': "I'm always open to chat",
          'wonder.title': 'A native Super Mario Maker 3',
          'wonder.sub': 'Available for PC and Android',
          'wonder.downloads': 'Downloads',
          'wonder.downloadBeta': 'Download Beta',
          'wonder.styles': 'Play styles',
          'wonder.stylesSub': 'This is just a beta; more styles will be added in the final version.',
          'wonder.style1': 'The classic Mario style, modernized.',
          'wonder.style2': 'Fly with the Tanooki with new physics.',
          'wonder.style3': 'The best 2D Mario of the 90s.',
          'wonder.style4': 'Play in this modern style natively.',
          'wonder.downloadTitle': 'Download the Beta',
          'wonder.downloadSub': 'Choose your platform and start creating levels.',
          'wonder.download': 'Download',
          'wonder.discordDesc': 'Join the official Discord server to keep up with the news, report bugs and share your levels.',
          'wonder.join': 'Join Wonder Cave',
          'support.title': 'Support',
          'support.before': 'An ad will open in',
          'support.after': 'seconds to support the project for free. You can close it as soon as it opens; after that you can download without any problem.',
          'support.download': 'Download',
          'support.close': 'Close'
        }
      };

      const WM_LANG_KEY = 'manzft-lang';
      const WM_PAGE_KEYS = {
        '/': 'home',
        '/wonder-maker': 'wonder',
        '/fanarts': 'fanarts',
        '/contact': 'contact'
      };

      function wmGetLang() {
        try {
          return localStorage.getItem(WM_LANG_KEY) === 'en' ? 'en' : 'es';
        } catch (e) {
          return 'es';
        }
      }

      function wmPageKey() {
        const path = location.pathname.replace(/\/+$/, '') || '/';
        return WM_PAGE_KEYS[path] || 'home';
      }

      function wmApplyLang(lang) {
        const dict = WM_I18N[lang] || WM_I18N.es;
        document.documentElement.lang = lang;

        document.querySelectorAll('[data-i18n]').forEach(function (el) {
          const value = dict[el.getAttribute('data-i18n')];
          if (value !== undefined) el.textContent = value;
        });

        document.querySelectorAll('[data-i18n-placeholder]').forEach(function (el) {
          const value = dict[el.getAttribute('data-i18n-placeholder')];
          if (value !== undefined) el.setAttribute('placeholder', value);
        });

        document.querySelectorAll('[data-i18n-aria]').forEach(function (el) {
          const value = dict[el.getAttribute('data-i18n-aria')];
          if (value !== undefined) el.setAttribute('aria-label', value);
        });

        document.querySelectorAll('.lang-label').forEach(function (el) {
          el.textContent = lang.toUpperCase();
        });

        document.querySelectorAll('.lang-toggle').forEach(function (el) {
          el.setAttribute('aria-label', dict['lang.switch']);
        });

        const pageKey = wmPageKey();
        const pageTitle = dict['page.' + pageKey];
        if (pageTitle) document.title = pageTitle + ' | Manzft';

        const meta = document.querySelector('meta[name="description"]');
        const metaText = dict['meta.' + pageKey];
        if (meta && metaText) meta.setAttribute('content', metaText);

        try {
          localStorage.setItem(WM_LANG_KEY, lang);
        } catch (e) {}
      }

      document.querySelectorAll('.lang-toggle').forEach(function (button) {
        button.addEventListener('click', function () {
          wmApplyLang(wmGetLang() === 'es' ? 'en' : 'es');
        });
      });

      function wmStart() {
        wmApplyLang(wmGetLang());
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', wmStart);
      } else {
        wmStart();
      }
    </script>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/10 bg-panel/60 backdrop-blur-xl py-8 mt-16">
      <div class="max-w-6xl mx-auto px-4 text-center text-sm text-ink-soft">
        <p>© {new Date().getFullYear()} Manzft</p>
      </div>
    </footer>

  </body>
</html>
